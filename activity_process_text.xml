<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="24dp"
    android:background="@drawable/popup_card_background"
    android:elevation="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Byar ah char Translate"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F766E" />
        <ImageButton
            android:id="@+id/pt_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </RelativeLayout>

    <TextView
        android:id="@+id/pt_original_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="#E2E8F0"
        android:textColor="#334155"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/pt_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textStyle="bold"
                android:textColor="#0F766E" />
            <ImageButton
                android:id="@+id/pt_copy_english"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Copy" />
        </RelativeLayout>
        <TextView
            android:id="@+id/pt_english_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translating..."
            android:textColor="#1E293B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamil (தமிழ்)"
                android:textStyle="bold"
                android:textColor="#B45309" />
            <ImageButton
                android:id="@+id/pt_copy_tamil"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Copy" />
        </RelativeLayout>
        <TextView
            android:id="@+id/pt_tamil_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="மொழிபெயர்க்கப்படுகிறது..."
            android:textColor="#1E293B"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
