<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="16dp"
    android:background="@drawable/popup_card_background"
    android:elevation="16dp">

    <!-- Header bar with title and close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Byar ah char Translate"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <ImageButton
            android:id="@+id/btn_popup_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close popup" />
    </RelativeLayout>

    <!-- Input text area -->
    <EditText
        android:id="@+id/et_burmese_input"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:gravity="top|start"
        android:padding="10dp"
        android:background="@drawable/input_field_bg"
        android:hint="Paste or enter Burmese text here..."
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_popup_paste"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📋 Paste"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_popup_translate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:text="Translate"
            android:backgroundTint="#0F766E" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/popup_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- English Result Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="#F1F5F9"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGLISH"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#0F766E" />
            <ImageButton
                android:id="@+id/btn_copy_english"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Copy English" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_english_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#1E293B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tamil Result Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="#F1F5F9"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMIL (தமிழ்)"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#B45309" />
            <ImageButton
                android:id="@+id/btn_copy_tamil"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Copy Tamil" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_tamil_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#1E293B"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
